# ═══════════════════════════════════════════════════════════════
# LangGraph SPCS Deployment Configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in your Snowflake details:
#     cp example.env .env
#
# `.env` is git-ignored so your real values are never committed.
# ═══════════════════════════════════════════════════════════════

# Required: Your Snowflake org and account identifiers
# Find these in Snowsight under Admin > Accounts, or from your account URL:
#   https://<SNOWFLAKE_ORG>-<SNOWFLAKE_ACCOUNT>.snowflakecomputing.com
SNOWFLAKE_ORG=<your_org>
SNOWFLAKE_ACCOUNT=<your_account>

# Snowflake CLI connection name (must exist in ~/.snowflake/connections.toml)
SNOW_CONNECTION=<your_connection_name>

# Database and schema where all objects will be created
SNOWFLAKE_DATABASE=LANGGRAPH_DB
SNOWFLAKE_SCHEMA=AGENTS

# Image repository name (created automatically by bootstrap.sql)
SNOWFLAKE_REPO=LANGGRAPH_REPO

# Docker image settings
IMAGE_NAME=langgraph-agent
IMAGE_TAG=v1

# Compute pool for the SPCS service
COMPUTE_POOL=LANGGRAPH_POOL

# SPCS service name
SERVICE_NAME=LANGGRAPH_SERVICE

# Warehouse used by the service for SQL queries
WAREHOUSE=<your_warehouse>

# MCP server and agent names
MCP_SERVER_NAME=LANGGRAPH_MCP
AGENT_NAME=MATH_AGENT
